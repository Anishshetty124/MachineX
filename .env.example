# Copy to .env and set your MongoDB Atlas or local connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=5000
CLIENT_URLS=http://localhost:5173,http://localhost:5000
JWT_SECRET=replace-with-a-long-random-server-secret
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@example.com
AI_SERVICE_URL=http://localhost:8000
# Gemini vision/reasoning provider used by the AI service.
GEMINI_API_KEY=
# Comma-separated authorized keys. If set, this takes precedence over GEMINI_API_KEY.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# YOLO inference service URL and optional auth key.
YOLO_API_URL=http://localhost:9000
YOLO_API_KEY=
YOLO_API_KEYS=
# Optional model-upload protection. Set true to require ADMIN_UPLOAD_KEY.
ADMIN_UPLOAD_REQUIRED=false
ADMIN_UPLOAD_KEY=replace-with-a-long-random-value
